# web/.env.local olarak kopyala. Uceu de OPSIYONELDIR; hicbiri olmadan da uygulama calisir.

# Ilerleme kaydi. Yoksa ilerleme yalnizca tarayicinin localStorage'inda tutulur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI rehber ucu (app/api/rehber). Yoksa rehber 500 doner, uygulamanin geri kalani calisir.
NVIDIA_NIM_API_KEY=

# Ders videolarinin sunuldugu yer. Bos birakilirsa /public/videos aranir.
# Videolar 4.6 GB oldugu icin repoda degil; dis depolamaya yuklenince buraya taban adresi yaz.
# Ornek: https://ornek.r2.dev
NEXT_PUBLIC_VIDEO_BASE=

# DIKKAT: service_role anahtari buraya da Vercel'e de KONULMAZ.
# Yalnizca yerel bakim scriptleri icin web/.env.local icinde durur, repoya girmez.
